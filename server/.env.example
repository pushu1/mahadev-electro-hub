PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL - Neon / Supabase / Local PostgreSQL)
# Example Neon connection string: postgresql://username:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/mahadev_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mahadev_electro_hub?schema=public"

# Security & Authentication Secrets
JWT_SECRET="mahadev_electro_hub_super_secure_jwt_secret_pali_rajasthan_2026"
