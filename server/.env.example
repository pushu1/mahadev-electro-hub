# Store & Admin Credentials (Used for initial seed & notifications)
ADMIN_EMAIL="admin@mahadevelectrohub.com"
ADMIN_PASSWORD="Admin@Mahadev2026"

# Frontend Origin for CORS
CLIENT_ORIGIN="http://localhost:5173"

# Payment Gateway (Razorpay - Optional until active keys configured)
RAZORPAY_KEY_ID=""
